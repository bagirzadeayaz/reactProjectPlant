rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email_verified == true &&
        request.auth.token.email in __ADMIN_EMAILS__;
    }

    function validGalleryItem(items, index) {
      return items.size() <= index || (items[index] is string &&
        items[index].size() > 0 && items[index].size() <= 2048);
    }

    function validVariant(items, index) {
      let variant = items.size() > index ? items[index] : {};
      return items.size() <= index || (variant is map &&
        variant.keys().hasAll(['id', 'size', 'heightCm', 'pot', 'price', 'stock', 'imageUrl']) &&
        variant.keys().hasOnly(['id', 'size', 'heightCm', 'pot', 'price', 'stock', 'imageUrl']) &&
        variant.id is string && variant.id.matches('^[a-zA-Z0-9-]{1,80}$') &&
        variant.size in ['small', 'medium', 'large'] &&
        variant.heightCm is int && variant.heightCm >= 5 && variant.heightCm <= 300 &&
        variant.pot in ['original', 'cream', 'sage', 'terracotta'] &&
        variant.price is int && variant.price >= 0 &&
        variant.stock is int && variant.stock >= 0 && variant.stock <= 999 &&
        variant.imageUrl is string && variant.imageUrl.size() > 0 && variant.imageUrl.size() <= 2048);
    }

    function validProduct() {
      let data = request.resource.data;
      return data.keys().hasAll([
        'slug', 'name', 'description', 'price', 'currency',
        'category', 'imageUrl', 'inStock', 'createdAt'
      ]) && data.keys().hasOnly([
        'slug', 'name', 'description', 'price', 'currency',
        'category', 'imageUrl', 'inStock', 'createdAt', 'gallery', 'status', 'care', 'variants', 'delivery'
      ]) &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 120 &&
        data.name is map && data.name.keys().hasAll(['en', 'ru']) &&
        data.name.en is string && data.name.ru is string &&
        data.description is map && data.description.keys().hasAll(['en', 'ru']) &&
        data.description.en is string && data.description.ru is string &&
        data.price is int && data.price >= 0 &&
        data.currency == 'AZN' &&
        data.category is string && data.category.size() > 0 &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 2048 &&
        data.inStock is bool && data.createdAt is string &&
        (!('variants' in data) || (data.variants is list && data.variants.size() <= 12 &&
          validVariant(data.variants, 0) && validVariant(data.variants, 1) &&
          validVariant(data.variants, 2) && validVariant(data.variants, 3) &&
          validVariant(data.variants, 4) && validVariant(data.variants, 5) &&
          validVariant(data.variants, 6) && validVariant(data.variants, 7) &&
          validVariant(data.variants, 8) && validVariant(data.variants, 9) &&
          validVariant(data.variants, 10) && validVariant(data.variants, 11))) &&
        (!('delivery' in data) || (data.delivery is map &&
          data.delivery.keys().hasAll(['areas', 'dispatchDays']) &&
          data.delivery.keys().hasOnly(['areas', 'dispatchDays']) &&
          data.delivery.areas is list && data.delivery.areas.size() >= 1 && data.delivery.areas.size() <= 3 &&
          data.delivery.areas.hasOnly(['baku', 'absheron', 'regions']) &&
          data.delivery.dispatchDays is int && data.delivery.dispatchDays >= 0 && data.delivery.dispatchDays <= 14)) &&
        (!('status' in data) || data.status in ['published', 'draft', 'archived']) &&
        (!('care' in data) || (data.care is map &&
          data.care.keys().hasAll(['light', 'watering', 'size', 'effort', 'humidity', 'pets']) &&
          data.care.keys().hasOnly(['light', 'watering', 'size', 'effort', 'humidity', 'pets']) &&
          data.care.light in ['low', 'bright', 'direct'] &&
          data.care.watering in ['dry', 'top-dry', 'moist'] &&
          data.care.size in ['compact', 'medium', 'large'] &&
          data.care.effort in ['easy', 'regular'] &&
          data.care.humidity in ['average', 'high'] &&
          data.care.pets in ['safe', 'toxic', 'unknown'])) &&
        (!('gallery' in data) || (data.gallery is list && data.gallery.size() <= 5 &&
          validGalleryItem(data.gallery, 0) && validGalleryItem(data.gallery, 1) &&
          validGalleryItem(data.gallery, 2) && validGalleryItem(data.gallery, 3) &&
          validGalleryItem(data.gallery, 4)));
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && validProduct() &&
        (!('status' in request.resource.data) || request.resource.data.status == 'published');
      allow delete: if isAdmin();
    }

    match /productWorkspace/{productId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validProduct() &&
        request.resource.data.status in ['draft', 'archived'];
      allow delete: if isAdmin();
    }

    match /productSlugs/{slug} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['productId']) &&
        request.resource.data.keys().hasOnly(['productId']) &&
        request.resource.data.productId is string;
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /images/{imageId} {
      allow read: if true;
      allow create: if isAdmin() &&
        imageId.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasAll(['contentType', 'bytes', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['contentType', 'bytes', 'createdAt']) &&
        request.resource.data.contentType in ['image/png', 'image/jpeg', 'image/webp', 'image/gif'] &&
        request.resource.data.bytes is bytes &&
        request.resource.data.bytes.size() <= 307200 &&
        request.resource.data.createdAt is string;
    }

    match /newsletterSubscribers/{subscriberId} {
      allow create: if subscriberId.matches('^[a-f0-9]{64}$') &&
        request.resource.data.keys().hasAll(['email', 'subscribedAt']) &&
        request.resource.data.keys().hasOnly(['email', 'subscribedAt']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 254 &&
        request.resource.data.email.matches('.*@.*') &&
        request.resource.data.subscribedAt is string;
      allow read, delete: if isAdmin();
    }

    match /metadata/{documentId} {
      allow get, create: if isAdmin();
    }
  }
}
