{
  "firestore": {
    "rules": "backend/firestore.rules"
  },
  "hosting": {
    "predeploy": "npm run build",
    "public": "frontend/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
