{
  "name": "planto",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:backend": "node --env-file=.env backend/src/server.js",
    "start": "node --env-file=.env backend/src/server.js",
    "rules:generate": "node --env-file=.env scripts/generate-firestore-rules.mjs",
    "lint": "eslint . && npm run check:architecture && npm run check:i18n",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run typecheck && npm run check:i18n && vite build",
    "preview": "vite preview",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "build:report": "npm run build && node scripts/bundle-report.mjs",
    "images": "node scripts/generate-images.mjs",
    "check": "npm run lint && npm run build",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.11.2",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=22"
  }
}
